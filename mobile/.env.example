# Public client configuration. Never place secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Optional overrides — defaults point at the project's Firebase app.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Set to 1 to always render the bundled demo portfolio.
# EXPO_PUBLIC_FORCE_DEMO=1

# Google Sign-In (requires a development build; unavailable in Expo Go).
# Use the Web OAuth client ID created by Firebase (Google Cloud Console →
# Credentials). Native builds also need google-services.json / the iOS plist.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com
# Only needed for iOS builds that use Google Cloud Console instead of a plist:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
